openapi: 3.0.3
info:
  title: Modernized {{ domain_name }} API
  version: 1.0.0
  description: OpenAPI 3.0 Contract for {{ domain_name }} microservice (Traceability ID: {{ jira_story_id }})
paths:
  /api/v1/{{ domain_name | lower }}s:
    get:
      summary: Retrieve all {{ domain_name }} resources
      responses:
        '200':
          description: Successful operation
    post:
      summary: Create new {{ domain_name }} resource
      responses:
        '201':
          description: Resource created successfully
