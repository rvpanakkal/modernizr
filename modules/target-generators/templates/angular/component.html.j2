<!-- Modernized Angular Microfrontend Template (Traceability: {{ jira_story_id }}) -->
<div class="card p-4 shadow-sm">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h2>{{ component_name }} Management</h2>
    <span class="badge bg-info">{{ jira_story_id }}</span>
  </div>
  <div class="card-body">
    <div *ngIf="loading()" class="spinner-border text-primary" role="status">
      <span class="visually-hidden">Loading...</span>
    </div>
    <ul *ngIf="!loading()" class="list-group">
      <li *ngFor="let item of items()" class="list-group-item">
        {% raw %}{{ item.name }}{% endraw %}
      </li>
    </ul>
  </div>
</div>
