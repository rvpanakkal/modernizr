# Infrastructure Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=modernization_secret
NEO4J_DATABASE=neo4j

# Pipeline Artifact Storage
ARTIFACTS_DIR=artifacts
RAW_LST_DIR=artifacts/raw_lst
RECEIPTS_DIR=artifacts/receipts
GENERATED_SPECS_DIR=artifacts/generated_specs

# Jira Integration
JIRA_BASE_URL=https://enterprise.atlassian.net
JIRA_USER_EMAIL=devops@enterprise.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=MOD

# Enterprise Service Catalog Integration
CATALOG_API_URL=https://catalog.internal.enterprise.com/api/v1
CATALOG_API_KEY=your_catalog_api_key_here

# LLM Cognitive Agents Configuration
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=claude-3-7-sonnet-20250219
MAX_CONTEXT_TOKENS=6000
